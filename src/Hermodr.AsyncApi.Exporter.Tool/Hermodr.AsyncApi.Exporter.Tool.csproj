<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       dotnet global tool: hermodr-asyncapi
       Single-targets net10.0 (tools cannot multi-target) and rolls
       forward to later patch releases. The export orchestration lives
       in the bundled Hermodr.AsyncApi.Exporter library.
  ============================================================ -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RollForward>LatestMajor</RollForward>

    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hermodr.Tool</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hermodr-asyncapi</ToolCommandName>
    <PackageId>Hermodr.AsyncApi.Exporter.Tool</PackageId>
    <Title>Hermodr AsyncAPI / OpenAPI Exporter</Title>
    <Description>A dotnet global tool that exports Hermodr event schemas to AsyncAPI 2.x or OpenAPI 3.1 documents without a running application host.</Description>
    <PackageTags>event;events;asyncapi;openapi;cli;tool;export</PackageTags>

    <!-- The export library is bundled inside the tool nupkg; do not flow it
         out as a NuGet dependency. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hermodr.AsyncApi.Exporter\Hermodr.AsyncApi.Exporter.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The CLI command type is internal by design; tests construct a
         Spectre CommandApp<ExportCommand> directly to drive the parser
         end-to-end, so the test project needs visibility into the tool's
         internals. -->
    <InternalsVisibleTo Include="Hermodr.AsyncApi.Exporter.Tool.XUnit" />
  </ItemGroup>

</Project>