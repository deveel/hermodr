<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Hermodr gRPC Publisher</Title>
    <Description>Provides a publisher of CloudEvents to statically-configured gRPC endpoints, using Grpc.Net.Client for low-latency, bidirectional service-to-service delivery. A pluggable IGrpcEventSender strategy integrates the channel with user-generated gRPC clients (from .proto contracts); a .proto generator for [Event]-annotated types is planned for v1.6.0.</Description>
    <PackageTags>event;events;ddd;publisher;grpc;cloudevents</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Core.Api" Version="2.83.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework) == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework) == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.15" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hermodr.Publisher\Hermodr.Publisher.csproj" />
  </ItemGroup>
</Project>
