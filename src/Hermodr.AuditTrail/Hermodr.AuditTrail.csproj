<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Hermodr Audit Trail</Title>
    <Description>Provides the core contracts for an append-only audit trail that records every published domain event for compliance auditing and debugging.</Description>
    <PackageTags>deveel;events;audit;trail;compliance;logging</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CloudNative.CloudEvents" Version="2.8.0" />
    <PackageReference Include="CloudNative.CloudEvents.SystemTextJson" Version="2.8.0" />
    <PackageReference Include="Kista" Version="1.6.3" />
  </ItemGroup>

</Project>
