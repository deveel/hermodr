<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Hermodr HTTP Publisher</Title>
    <Description>Provides a lightweight publisher of CloudEvents to statically-configured HTTP endpoints using the CloudEvents HTTP binding (structured and binary content modes), with per-endpoint authentication and resilience via IHttpClientFactory.</Description>
    <PackageTags>event;events;ddd;publisher;http;cloudevents</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hermodr.Publisher\Hermodr.Publisher.csproj" />
  </ItemGroup>
</Project>
