<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrderService.GrpcServer</RootNamespace>
    <AssemblyName>OrderService.GrpcServer</AssemblyName>
    <Description>
      ASP.NET Core gRPC receiver for the Hermodr gRPC publisher sample:
      implements the application-defined OrderEvents contract generated from
      protos/order_events.proto.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\protos\order_events.proto" GrpcServices="Server" />
  </ItemGroup>

</Project>
